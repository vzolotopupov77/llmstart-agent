# OpenRouter API key — обязателен для запуска mentor check
# Получить: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Модель LLM (перекрывает mentor/config/config.yaml)
# MODEL=google/gemini-2.5-flash

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Режим вывода CLI: verbose | compact (перекрывает config.yaml)
# OUTPUT_MODE=verbose

# Лимит контекста в токенах (перекрывает config.yaml)
# CONTEXT_LIMIT=128000

# Порог суммаризации истории в токенах (перекрывает config.yaml)
# SUMMARIZATION_THRESHOLD=80000

# Лимит шагов агента (LangGraph recursion_limit; перекрывает config.yaml)
# AGENT_RECURSION_LIMIT=200

# Макс. попыток при ранней остановке агента (перекрывает config.yaml)
# AGENT_MAX_ATTEMPTS=10

# Таймаут одного LLM-запроса через OpenRouter, секунды (синтез на большом контексте)
# LLM_REQUEST_TIMEOUT=600
